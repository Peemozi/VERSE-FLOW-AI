# Google Cloud Speech-to-Text (main process only)
# Path to a service-account JSON key file. Never commit the key.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional STT language code overrides
# VERSEFLOW_STT_EN_CODE=en-NG
# VERSEFLOW_STT_YO_CODE=yo-NG

# Optional app overrides
VERSEFLOW_DB_PATH=
VERSEFLOW_DATA_DIR=
VERSEFLOW_LOG_LEVEL=info
